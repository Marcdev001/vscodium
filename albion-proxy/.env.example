# ===========================================================================
# Albion Proxy - Environment Configuration
# Copy this file to .env or .env.test and fill in your keys
# ===========================================================================

# --- Supabase (Auth, Vector Embeddings, Caps & Usage Ledger) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- Albion Proxy Server Configuration ---
PORT=3000
ALLOWED_ORIGINS=*
RATE_LIMIT_STORE=memory # Set to 'redis' in production with REDIS_URL configured

# --- LiteLLM Proxy (Paid Cloud Model Routing) ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-albion-proxy-key-CHANGE-ME-IN-PROD
DATABASE_URL=postgresql://user:pass@host:5432/litellm_db

# --- Paid AI Provider Keys (Cloud Models with Free Sign-up Credits) ---
# DeepInfra: DeepSeek-V4-Flash & DeepSeek-V4-Pro ($1-$5 free signup credits)
DEEPINFRA_API_KEY=your-deepinfra-api-key
# Together AI: Qwen 3.6 & GLM-5.2 ($5-$25 free signup credits)
TOGETHER_API_KEY=your-together-api-key

# --- Free Tier Cloud Providers (Zero-Cost Stacked Fallback) ---
# Both providers offer generous free tiers and require NO credit card.
# OpenRouter Free: DeepSeek-R1:free or Qwen-3-Coder:free (starts with sk-or-v1-...)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
# Groq Free: Llama-3.1-8b-instant or Qwen3-32b (starts with gsk_...)
GROQ_API_KEY=gsk_your-groq-key

# --- Billing Providers: Paystack (Local NGN Payments) ---
# Paystack Test Secret Key from https://dashboard.paystack.com/#/settings/developer (starts with sk_test_...)
PAYSTACK_TEST_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# --- Billing Providers: Lemon Squeezy (International USD Payments) ---
# Lemon Squeezy API Key (Get free at https://app.lemonsqueezy.com/settings/api)
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
# Lemon Squeezy Webhook Secret (From Lemon Squeezy Webhooks dashboard)
LEMONSQUEEZY_WEBHOOK_SECRET=your-lemonsqueezy-webhook-signing-secret
# Lemon Squeezy Store ID (Your store ID from Lemon Squeezy settings)
LEMONSQUEEZY_STORE_ID=your-lemonsqueezy-store-id

# --- Production Error Tracking (Optional) ---
SENTRY_DSN=
